/*
 * SPDX-License-Identifier: MIT
 *
 * Lemon Wired overlay for the UDC sample. The Link USB-C port (D+ on
 * GP0, D- on GP1) drives Pico-PIO-USB in device mode.
 *
 * &uart0 owns GP0/GP1 by default for the wired-split transport — we
 * disable it here so Pico-PIO-USB can take the pins. The board's
 * native USBD stays available but isn't used by this sample.
 */

&uart0 {
	status = "disabled";
};

/ {
	pio_usb_device: pio_usb_device {
		compatible = "raspberrypi,pio-usb-device";
		pin-dp = <0>;
		pinout = "dpdm";
		data-rate = "full-speed";
		status = "okay";
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
	};
};

/* Triage build: native USB-C exposes a CDC ACM serial console via the
 * legacy USB device stack (so we get logs out of the firmware). The
 * Link USB-C port runs udc_pio_usb but exposes no class — the
 * standalone-PIO-USB-init smoke test is sufficient until USBD-next +
 * CDC ACM dual-stack issues are resolved. */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
