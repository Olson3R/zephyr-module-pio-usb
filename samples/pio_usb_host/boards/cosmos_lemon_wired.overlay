/*
 * SPDX-License-Identifier: MIT
 *
 * Lemon Wired overlay for the UHC sample. The Link USB-C port (D+ on
 * GP0, D- on GP1) drives Pico-PIO-USB. The native USB-C port stays on
 * &usbd for the CDC ACM serial console.
 *
 * &uart0 owns GP0/GP1 by default for the wired-split transport — we
 * disable it here so Pico-PIO-USB can take the pins.
 */

&uart0 {
	status = "disabled";
};

/ {
	pio_usb_host: pio_usb_host {
		compatible = "raspberrypi,pio-usb-host";
		pin-dp = <0>;
		pinout = "dpdm";
		data-rate = "full-speed";
		status = "okay";
	};
};
